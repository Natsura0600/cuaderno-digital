# Upstash Redis. Si conectás la base desde el Marketplace de Vercel, estas variables se crean solas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Alternativa si la base la creaste directo en upstash.com)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Para desarrollo en tu computadora sin Upstash: un Redis local
# REDIS_URL=redis://localhost:6379

# Clave larga y aleatoria para firmar las sesiones (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=

# Opcional: Vercel Blob para subir archivos (recursos y documentación de matrícula)
BLOB_READ_WRITE_TOKEN=

# Opcional: nombre que muestra la app
NEXT_PUBLIC_COLEGIO="Colegio Montessori de Luján"
NEXT_PUBLIC_SEDE="Sede Acceso Oeste"
